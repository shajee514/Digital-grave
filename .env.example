# ==========================================================================
#  DIGITAL GRAVE ($RIP) — ENVIRONMENT CONFIGURATION
#  Copy this file to ".env.local" and fill in values as they become known.
#  Anything starting with NEXT_PUBLIC_ is visible in the browser.
#  Anything WITHOUT that prefix is server-only and must never be shared.
# ==========================================================================

# --------------------------------------------------------------------------
# DATA MODE
# "demo" = website runs on clearly-labelled fake data (safe before launch)
# "live" = website reads real indexed blockchain data from Supabase
# --------------------------------------------------------------------------
NEXT_PUBLIC_DATA_MODE="demo"

# --------------------------------------------------------------------------
# ROBINHOOD CHAIN
# --------------------------------------------------------------------------
NEXT_PUBLIC_RH_CHAIN_ID="4663"
NEXT_PUBLIC_RH_CHAIN_NAME="Robinhood Chain"
NEXT_PUBLIC_RH_RPC_URL=""
NEXT_PUBLIC_RH_EXPLORER_URL=""
NEXT_PUBLIC_RH_NATIVE_SYMBOL="ETH"
NEXT_PUBLIC_RH_NATIVE_DECIMALS="18"

# --------------------------------------------------------------------------
# $RIP TOKEN — leave empty until the token is actually deployed.
# NEVER invent an address here.
# --------------------------------------------------------------------------
NEXT_PUBLIC_RIP_TOKEN_ADDRESS=""
NEXT_PUBLIC_RIP_TOKEN_DECIMALS="18"
NEXT_PUBLIC_RIP_TOKEN_SYMBOL="RIP"

# --------------------------------------------------------------------------
# DEX — needed so the indexer can tell a BUY/SELL apart from a plain transfer.
# Comma-separate if there is more than one pair/router.
# --------------------------------------------------------------------------
NEXT_PUBLIC_RIP_PAIR_ADDRESS=""
NEXT_PUBLIC_RIP_ROUTER_ADDRESS=""
NEXT_PUBLIC_RIP_FACTORY_ADDRESS=""
NEXT_PUBLIC_DEX_NAME=""
NEXT_PUBLIC_DEX_SWAP_URL=""

# --------------------------------------------------------------------------
# SUPABASE (Phase 2)
# The SERVICE ROLE key is server-only. Never prefix it with NEXT_PUBLIC_.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --------------------------------------------------------------------------
# INDEXER (Phase 4)
# --------------------------------------------------------------------------
INDEXER_ENABLED="false"
INDEXER_START_BLOCK="0"
INDEXER_BATCH_SIZE="2000"
INDEXER_POLL_INTERVAL_MS="12000"
INDEXER_PROVIDER=""
INDEXER_API_KEY=""
INDEXER_CRON_SECRET=""

# --------------------------------------------------------------------------
# ADMIN (Phase 2+) — a long random string. Not a wallet key.
# --------------------------------------------------------------------------
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --------------------------------------------------------------------------
# REWARDS — "Lucky Survivor". Stays OFF until legal review is done.
# --------------------------------------------------------------------------
NEXT_PUBLIC_REWARDS_ENABLED="false"
NEXT_PUBLIC_REWARDS_MODE="collectible"

# --------------------------------------------------------------------------
# SITE + SOCIAL LINKS — leave empty until real accounts exist.
# Empty links are hidden in the UI instead of showing a fake destination.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_DISCORD_URL=""
